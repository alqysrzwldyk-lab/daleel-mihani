MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>
JWT_SECRET=change-this-to-a-long-random-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# بيانات إنشاء مدير النظام عبر npm run create-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
# إعدادات بوابة الدفع — Paymob (مطلوبة لشحن المحفظة بالبطاقة)
# سجّل في https://merchant.paymob.com → Settings → Account Info
PAYMOB_SECRET_KEY=sk_test_xxxxxxxx
PAYMOB_PUBLIC_KEY=pk_test_xxxxxxxx
PAYMOB_HMAC_SECRET=your_hmac_secret_from_paymob_dashboard
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_BASE_URL=https://accept.paymob.com
# Egypt: https://accept.paymob.com | UAE: https://uae.paymob.com
# KSA: https://ksa.paymob.com | Oman: https://oman.paymob.com
